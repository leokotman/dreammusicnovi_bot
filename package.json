{
  "name": "dreammusic-bot",
  "version": "1.0.0",
  "description": "Telegram bot for a music teacher - lessons info, FAQ, contact",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "postinstall": "npm run build",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "npx jest",
    "test:watch": "npx jest --watch"
  },
  "keywords": ["telegram", "bot", "telegraf", "music"],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18"
  }
}
