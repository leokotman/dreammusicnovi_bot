# Required: get from @BotFather
BOT_TOKEN=your_bot_token_here

# Forward "ask your question" to the teacher (numeric Telegram chat ID, not username)
# Only this user can use /admin and edit content
# How to get: message @userinfobot or @getidsbot — they reply with your ID
# TEACHER_CHAT_ID=123456789

# Contact links (shown in "Contact the teacher")
# TEACHER_TELEGRAM=teacher_username
# TEACHER_INSTAGRAM=https://instagram.com/teacher
# TEACHER_EMAIL=teacher@example.com
