# Required: get from @BotFather
BOT_TOKEN=your_bot_token_here

# Forward "ask your question" to the teacher (numeric Telegram chat ID)
# How to get: message @userinfobot or @getidsbot — they reply with your ID
# TEACHER_CHAT_ID=123456789

# Who can use /admin and edit content (at least one required for first login)
# TEACHER_USER_ID=123456789
# DEV_ID=987654321
# Optional: comma-separated list of extra admin IDs (e.g. ADMIN_IDS=111,222,333)
# Additional admins can be added from Telegram with /add_admin (stored in data/admins.json)
# ADMIN_IDS=123456789,234567890

# Vercel webhook authentication: independent random base64url secrets, 32-256 characters.
# POST updates fail closed with 503 until TELEGRAM_WEBHOOK_SECRET is configured.
# Configure the same secret_token with Telegram explicitly before deploying this handler.
# Keep the current webhook URL and pending updates; do not start polling to configure it.
TELEGRAM_WEBHOOK_SECRET=
# Used only for initial registration when no webhook exists; request Host is never trusted.
# TELEGRAM_WEBHOOK_URL=https://your-isolated-bot.example/api/webhook
# Optional separate administrative credential for explicit registration.
# Existing GET /api/webhook?set=THIS_VALUE remains an administrative operation.
# WEBHOOK_SET_SECRET=

# Vercel: connect your Blob store to this project. OIDC uses BLOB_STORE_ID automatically.
# Keep BLOB_READ_WRITE_TOKEN only if you need static-token access (for example outside Vercel).
# BLOB_READ_WRITE_TOKEN=...

# Rate limit: max text messages per user per minute (default 5). Change without redeploy via .env.local or Vercel env.
# RATE_LIMIT_MAX_PER_MINUTE=5

# Contact links (shown in "Contact the teacher")
# TEACHER_TELEGRAM=teacher_username
# TEACHER_INSTAGRAM=https://instagram.com/teacher
# TEACHER_EMAIL=teacher@example.com

# Website submission notifications (independent of /admin editing permissions).
# Keep off until the isolated database, queue, credentials, and recipients are verified.
WEBSITE_DELIVERY_ENABLED=false
# Comma-separated numeric private chat IDs or staff group IDs; duplicates are removed.
# Telegram app search supports private usernames, but Bot API sends to private users
# require numeric chat IDs. Each private recipient must first start this bot.
# Configure recipients here; no real recipient accounts are hardcoded in the app.
WEBSITE_NOTIFICATION_CHAT_IDS=
# Expected bot ID (numeric prefix of BOT_TOKEN); use the test bot for local/staging.
WEBSITE_DELIVERY_BOT_ID=
# Separate bot delivery PostgreSQL database. Never use the website Payload database.
BOT_DELIVERY_DATABASE_URL=
# Independent random secrets, each at least 32 characters. Keep server-side.
WEBSITE_DELIVERY_API_SECRET=
WEBSITE_DELIVERY_EXECUTION_SECRET=
# Optional previous secrets during rotation.
# WEBSITE_DELIVERY_API_SECRET_PREVIOUS=
# WEBSITE_DELIVERY_EXECUTION_SECRET_PREVIOUS=
# Authenticated Cloudflare producer Worker endpoint, ending in /publish.
DELIVERY_QUEUE_PUBLISH_URL=
DELIVERY_QUEUE_PUBLISH_SECRET=
