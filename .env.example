# Required: get from @BotFather
BOT_TOKEN=your_bot_token_here

# Forward "ask your question" to the teacher (numeric Telegram chat ID)
# How to get: message @userinfobot or @getidsbot — they reply with your ID
# TEACHER_CHAT_ID=123456789

# Who can use /admin and edit content (at least one required for first login)
# TEACHER_USER_ID=123456789
# DEV_ID=987654321
# Optional: comma-separated list of extra admin IDs (e.g. ADMIN_IDS=111,222,333)
# Additional admins can be added from Telegram with /add_admin (stored in data/admins.json)
# ADMIN_IDS=123456789,234567890

# Vercel only: secret for one-time webhook setup (GET /api/webhook?set=THIS_VALUE)
# WEBHOOK_SET_SECRET=your_random_secret

# Vercel only: set automatically when you create a Blob store (Storage → Blob). Lets /admin edits and /add_admin persist.
# BLOB_READ_WRITE_TOKEN=...

# Contact links (shown in "Contact the teacher")
# TEACHER_TELEGRAM=teacher_username
# TEACHER_INSTAGRAM=https://instagram.com/teacher
# TEACHER_EMAIL=teacher@example.com
